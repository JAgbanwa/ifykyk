N = 176959370426063526189820447723837571181114689072145824174813

# Denominator possibilities (non-integer only)
b_options = [3, N, 3*N]
d_options = [2, N, 2*N]

print("b options:", [str(b)[:20] + "..." if b > 10^10 else str(b) for b in b_options])
print("d options:", [str(d)[:20] + "..." if d > 10^10 else str(d) for d in d_options])

# We'll search numerators up to these limits
# Since denominators are huge, we need to search intelligently
# Let's use modular arithmetic to find possible numerator patterns

def find_candidate_numerators(denom, max_num=10000):
    """Find numerators coprime to denom up to max_num"""
    candidates = []
    for a in range(1, max_num + 1):
        if gcd(a, denom) == 1:
            candidates.append(a)
    return candidates

# For small denominators, we can enumerate all numerators
# For huge denominators (N, 3N, 2N), we need to search strategically

def search_single_case(b, d, max_a=1000, max_c=1000):
    """Search a single (b,d) pair with given numerator bounds"""
    solutions = []
    
    # For small b,d, we can check all numerators
    if b < 10^6 and d < 10^6:
        a_range = range(1, b)
        c_range = range(1, d)
    else:
        # For huge denominators, we need to search in specific ranges
        # We'll try small numerators first (since they might yield solutions)
        a_range = range(1, min(max_a + 1, b))
        c_range = range(1, min(max_c + 1, d))
    
    for a in a_range:
        if gcd(a, b) != 1:
            continue
        s = a / b
        
        # Quick modular check for this s with all c
        for c in c_range:
            if gcd(c, d) != 1:
                continue
            t = c / d
            
            try:
                # Compute the value
                val = (A*s + B*t + C)^2 + (D*s^3 + E*s^2 + F*s + G) / (B*t + H)
                
                # Check if integer and square
                if val.denominator() == 1 and val > 0:
                    y = is_square(val)
                    if y[0] and y[1] != 0:
                        solutions.append((s, t, y[1]))
                        print(f"Found: s={s}, t={t}, y={y[1]}")
            except:
                continue
    
    return solutions

# Prepare work items for parallel processing
work_items = []
max_a = 1000  # Start small, increase if needed
max_c = 1000

for b in b_options:
    for d in d_options:
        work_items.append((b, d, max_a, max_c))

print(f"\nSearching {len(work_items)} (b,d) combinations...")
print(f"With numerators up to {max_a} and {max_c}")

# Parallel execution
n_cores = cpu_count()
print(f"Using {n_cores} cores")

@parallel(ncpus=n_cores)
def parallel_search_case(b, d, max_a, max_c):
    return search_single_case(b, d, max_a, max_c)

start_time = time.time()
all_results = []

for result in parallel_search_case(work_items):
    solutions = result[1]
    if solutions:
        all_results.extend(solutions)
        print(f"Found {len(solutions)} solutions in this chunk")

elapsed = time.time() - start_time
print(f"\nSearch completed in {elapsed:.2f} seconds")
print(f"Total solutions found: {len(all_results)}")

for s, t, y in all_results:
    print(f"s = {s}, t = {t}, y = {y}")

# If no solutions found, try with larger numerator ranges
if len(all_results) == 0:
    print("\nTrying larger numerator ranges...")
    
    # Try progressively larger ranges
    for max_a in [10^4, 10^5, 10^6]:
        for max_c in [10^4, 10^5, 10^6]:
            print(f"\nTesting with max_a={max_a}, max_c={max_c}")
            
            work_items = [(b, d, max_a, max_c) for b in b_options for d in d_options]
            
            @parallel(ncpus=n_cores)
            def parallel_search_large(b, d, max_a, max_c):
                return search_single_case(b, d, max_a, max_c)
            
            all_results = []
            start_time = time.time()
            
            for result in parallel_search_large(work_items):
                solutions = result[1]
                if solutions:
                    all_results.extend(solutions)
                    print(f"Found {len(solutions)} solutions")
            
            elapsed = time.time() - start_time
            print(f"Search completed in {elapsed:.2f} seconds")
            print(f"Total solutions found: {len(all_results)}")
            
            for s, t, y in all_results:
                print(f"s = {s}, t = {t}, y = {y}")
            
            if all_results:
                break
        if all_results:
            break
