Z := Integers();

A :=
7722748144662314316341908960081961607360287349497686106628841645044269806696204493835608082856277613;

B :=
2459699553559650153531134301719167924255823126265277232895789785654434945479389692784296352235122655;

///////////////////////////////////////////////////////////////////////////
// Equation:
//
//      3*y = A*x + B
///////////////////////////////////////////////////////////////////////////

assert A mod 3 eq 0;
assert B mod 3 eq 0;

P := A div 3;
Q := B div 3;

print "Equation simplifies to:";
printf "y = %o*x + %o\n", P, Q;

print "";
print "Complete family of integer solutions:";
print "(x,y) = (n, P*n + Q), n in Z";
print "";

printf "P = %o\n", P;
printf "Q = %o\n", Q;

///////////////////////////////////////////////////////////////////////////
// Parametric solution
///////////////////////////////////////////////////////////////////////////

function Solution(n)

    x := n;
    y := P*n + Q;

    // Exact verification
    assert 3*y eq A*x + B;

    return x,y;

end function;


///////////////////////////////////////////////////////////////////////////
// Example values
///////////////////////////////////////////////////////////////////////////

for n in [-5..5] do

    x,y := Solution(n);

    printf "n = %o:  x = %o,  y = %o\n",
        n,x,y;

end for;
