import Mathlib
/-!
# Integrality of `(350892 * m ^ 3 - 1) / k`
For each digit size `dd = 10, 20, ..., 100` we exhibit `dd`-digit constants
`a₁, b₁, a₂, b₂`, **all four pairwise distinct** (in particular `a₁ ≠ a₂` and
`a₁ ≠ b₂`), such that
  `k ≡ a₁ (mod b₁)`, `0 < k < b₁`, and `m ≡ a₂ (mod b₂)`
force `k ∣ 350892 * m ^ 3 - 1`, i.e. `(350892 * m ^ 3 - 1) / k` is an integer.
Here `a₁ = p` is a prime with `p ≡ 2 (mod 3)` (so cubing is a bijection mod `p`),
`b₁ = 10 ^ dd - 1`, the modulus for `m` is `b₂ = 2 * p` (a genuine multiple of `p`,
so `b₂ ≠ a₁`), and `a₂ ∈ (p, 2p)` is the residue mod `b₂` with
`350892 * a₂ ^ 3 ≡ 1 (mod p)` (so `a₂ ≠ a₁` and `a₂ ≠ b₂`).  The `m`-congruence is
unrestricted: *every* integer `m` in the class `a₂ (mod b₂)` works.  The side
conditions `0 < k < b₁` on the `k`-congruence cannot be dropped:
`no_unbounded_k_congruence` below shows that no pair of congruences can force the
divisibility for *all* `k` in a residue class.
-/
namespace CubicCongruence
/-- If `m ≡ a (mod b)`, `p ∣ b` and `p ∣ 350892 * a ^ 3 - 1`,
then `p ∣ 350892 * m ^ 3 - 1`. -/
lemma dvd_of_emod_dvd (p b a m : ℤ) (hpb : p ∣ b) (hm : m % b = a)
    (hd : p ∣ 350892 * a ^ 3 - 1) : p ∣ 350892 * m ^ 3 - 1 := by
  have hpm : p ∣ m - a := hpb.trans (Int.dvd_self_sub_of_emod_eq hm)
  have h : m ≡ a [ZMOD p] := Int.ModEq.symm (Int.modEq_iff_dvd.mpr hpm)
  have h2 : 350892 * m ^ 3 - 1 ≡ 350892 * a ^ 3 - 1 [ZMOD p] :=
    ((h.pow 3).mul_left 350892).sub_right 1
  simpa using dvd_add h2.symm.dvd hd
/-- **10-digit congruences.**  With the 10-digit constants
`a₁ = 1000000007`, `b₁ = 9999999999`,
`a₂ = 1600805382`, `b₂ = 2000000014`
(pairwise distinct, in particular `a₁ ≠ a₂` and `a₁ ≠ b₂`):
if `k ≡ a₁ (mod b₁)` with `0 < k < b₁`, and `m ≡ a₂ (mod b₂)`, then
`(350892 * m ^ 3 - 1) / k` is an integer. -/
theorem integrality_digits_10 (k m : ℤ)
    (hk : k % 9999999999 = 1000000007) (hk0 : 0 < k) (hk1 : k < 9999999999)
    (hm : m % 2000000014 = 1600805382) :
    k ∣ 350892 * m ^ 3 - 1 := by
  have hkk : k = 1000000007 := by omega
  subst hkk
  exact dvd_of_emod_dvd _ _ _ _ ⟨2, by norm_num⟩ hm ⟨1439425098733741789121065, by norm_num⟩
/-- The four 10-digit constants `a₁, b₁, a₂, b₂` are pairwise distinct. -/
theorem constants_distinct_10 :
    ([1000000007, 9999999999, 1600805382, 2000000014] : List ℤ).Nodup := by decide
