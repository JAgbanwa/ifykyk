/-- The side conditions `0 < k < b₁` are essential: no pair of congruences can force
`k ∣ 350892 * m ^ 3 - 1` for *every* `k` in a residue class `a₁ (mod b₁)`. -/
theorem no_unbounded_k_congruence (a₁ b₁ a₂ b₂ : ℤ) (hb₁ : 0 < b₁)
    (ha₂ : 0 ≤ a₂) (ha₂' : a₂ < b₂) :
    ¬ ∀ k m : ℤ, k % b₁ = a₁ % b₁ → m % b₂ = a₂ → k ∣ 350892 * m ^ 3 - 1 := by
  intro h
  set N : ℤ := 350892 * a₂ ^ 3 - 1 with hN
  have hNne : 0 < |N| := by
    rcases eq_or_lt_of_le ha₂ with h0 | h0
    · simp [hN, ← h0]
    · have : 1 ≤ a₂ ^ 3 := one_le_pow₀ h0
      rw [abs_pos, hN]; nlinarith
  set k : ℤ := a₁ % b₁ + b₁ * (|N| + 1) with hk
  have hk0 : 0 ≤ a₁ % b₁ := Int.emod_nonneg _ (by omega)
  have hkgt : |N| < k := by
    have h5 : b₁ * (|N| + 1) ≥ 1 * (|N| + 1) :=
      mul_le_mul_of_nonneg_right hb₁ (by omega)
    simp only [hk]; omega
  have hdvd := h k a₂ (by simp [hk, Int.add_mul_emod_self_left, Int.emod_emod_of_dvd])
    (Int.emod_eq_of_lt ha₂ ha₂')
  have := Int.le_of_dvd hNne ((dvd_abs k N).mpr hdvd)
  omega
end CubicCongruence
