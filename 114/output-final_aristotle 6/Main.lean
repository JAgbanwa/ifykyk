/-!
# Congruence conditions making `(36 * n ^ 3 - 19) / x` an integer
For each digit size `d ∈ {20, 40, 60, 80, 100}` we exhibit four `d`-digit numbers
`a₁, b₁, a₂, b₂` such that every pair of integers `(x, n)` with
* `x ≡ a₁ [ZMOD b₁]` and `0 < x < b₁`,
* `n ≡ a₂ [ZMOD b₂]`,
satisfies `x ∣ 36 * n ^ 3 - 19`, i.e. the fraction `(36 * n ^ 3 - 19) / x` is an integer.
Here `a₁ = p` is a prime with `p ≡ 2 [ZMOD 3]` (so that cubing is a bijection modulo `p`),
`b₁ = 2 * p`, `b₂ = 3 * p`, and `a₂` is a solution of `36 * a₂ ^ 3 ≡ 19 [ZMOD p]`.
In particular all four constants of a family are distinct; notably `a₁ ≠ b₂`.
The range condition `0 < x < b₁` singles out the representative `x = a₁` of the residue class,
which is necessary: for a fixed `n`, only finitely many `x` can divide the nonzero number
`36 * n ^ 3 - 19`, so no infinite residue class of `x` can work.
-/
/-- Key lemma: if `p ∣ 36 * n₀ ^ 3 - 19` (witnessed by the factorisation `36 * n₀ ^ 3 - 19 = p * q`),
then any `x` in the residue class of `p` modulo `2 * p` lying in `(0, 2 * p)` — necessarily `x = p` —
divides `36 * n ^ 3 - 19` for every `n ≡ n₀ [ZMOD p]`. -/
theorem int_div_of_congruences (p q n0 x n : ℤ) (hp : 0 < p)
    (hq : 36 * n0 ^ 3 - 19 = p * q)
    (hx : x ≡ p [ZMOD 2 * p]) (hx0 : 0 < x) (hx1 : x < 2 * p)
    (hn : n ≡ n0 [ZMOD p]) : x ∣ 36 * n ^ 3 - 19 := by
  obtain ⟨k, hk⟩ := hx.dvd
  have hk0 : k = 0 := by
    rcases lt_trichotomy k 0 with h | h | h
    · nlinarith
    · exact h
    · nlinarith
  subst hk0
  have hxp : x = p := by linarith [hk]
  subst hxp
  obtain ⟨t, ht⟩ := hn.dvd
  have hn' : n = n0 - x * t := by linarith
  subst hn'
  exact ⟨q + 36 * (-3 * n0 ^ 2 * t + 3 * n0 * x * t ^ 2 - x ^ 2 * t ^ 3), by linear_combination hq⟩
/-- The range restriction `0 < x < b₁` in the statements below cannot be dropped: for a fixed `n`,
no full residue class of positive integers `x` can consist of divisors of `36 * n ^ 3 - 19`,
simply because that number is nonzero and hence has only finitely many divisors. -/
theorem no_full_residue_class (a b n : ℤ) (hb : 0 < b) :
    ¬ ∀ x : ℤ, x ≡ a [ZMOD b] → 0 < x → x ∣ 36 * n ^ 3 - 19 := by
  intro h
  have hN : 36 * n ^ 3 - 19 ≠ 0 := by
    have : ∀ m : ℤ, 36 * m - 19 ≠ 0 := by intro m; omega
    exact this (n ^ 3)
  set N : ℤ := 36 * n ^ 3 - 19 with hNdef
  set k : ℤ := |N| + |a| + 1 with hk
  have hk0 : 0 < k := by positivity
  have hbk : b * k ≥ k := le_mul_of_one_le_left hk0.le hb
  have habs : -|a| ≤ a := neg_abs_le a
  have hx : a + b * k ≡ a [ZMOD b] := Int.modEq_iff_dvd.mpr ⟨-k, by ring⟩
  have hxpos : 0 < a + b * k := by simp only [hk] at hbk ⊢; linarith [abs_nonneg N]
  have hle : a + b * k ≤ |N| := Int.le_of_dvd (abs_pos.mpr hN) ((dvd_abs _ _).mpr (h _ hx hxpos))
  simp only [hk] at hbk hle
  linarith
/-- Variant of `int_div_of_congruences` in which the congruence on `n` is taken modulo `3 * p`
(this is the form used below, where `b₂ = 3 * p`, so that `a₁ = p` differs from `b₂`). -/
theorem int_div_of_congruences_mul_three (p q n0 x n : ℤ) (hp : 0 < p)
    (hq : 36 * n0 ^ 3 - 19 = p * q)
    (hx : x ≡ p [ZMOD 2 * p]) (hx0 : 0 < x) (hx1 : x < 2 * p)
    (hn : n ≡ n0 [ZMOD 3 * p]) : x ∣ 36 * n ^ 3 - 19 :=
  int_div_of_congruences p q n0 x n hp hq hx hx0 hx1 (Int.ModEq.of_dvd ⟨3, by ring⟩ hn)
