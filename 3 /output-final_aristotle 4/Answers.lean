import RequestProject.Core
/-!
# Explicit answers with 10-, 20-, 30-, 40- and 50-digit data
For each digit size `d ∈ {10, 20, 30, 40, 50}` we give four `d`-digit numbers
`a₁, b₁, a₂, b₂` such that
* `a₁ = 5^k` for a suitable `k`, `b₂ = 2 * 5^k = 2 * a₁` (so `a₁ ≠ b₂`), and
  `b₁ = 10^d - 1`;
* `char_d` : for **every** integer `n`,  `b₂ ∣ P n ↔ n ≡ a₂ (mod b₂)`
  (so the congruence on `n` is exactly the right one — not merely sufficient);
* `answer_d` : if `0 < x < b₁` and `x ≡ a₁ (mod b₁)` (which pins `x = a₁`) and
  `n ≡ a₂ (mod b₂)`, then `P n / x` is an integer, i.e. `∃ q, P n = x * q`;
* `digits_d` : each of `a₁, b₁, a₂, b₂` lies in `[10^(d-1), 10^d)`, i.e. has exactly
  `d` digits, and `a₁ ≠ b₂`.
The bound `0 < x < b₁` is genuinely needed: by `not_forall_dvd_of_modEq`, the congruence
`x ≡ a₁ (mod b₁)` alone can never force `x ∣ P n`, since the residue class contains
integers larger than `|P n|`.
-/
namespace CubicFraction
/-- **10-digit data**: `a₁ = 1220703125 = 5^13`, `b₁ = 9999999999`,
`a₂ = 1628355764`, `b₂ = 2441406250 = 2 * 5^13`.
Note `a₁ ≠ b₂` (indeed `b₂ = 2 * a₁`).
Characterisation: `2 * 5^13 ∣ P n` holds precisely for `n ≡ a₂ (mod b₂)`. -/
theorem char_10 (n : ℤ) :
    (2441406250 : ℤ) ∣ P n ↔ n ≡ 1628355764 [ZMOD 2441406250] := by
  have h : (2 : ℤ) * (5 : ℤ) ^ 13 = 2441406250 := by norm_num
  have ha : (2 * (5 : ℤ) ^ 13) ∣ P 1628355764 := by
    rw [h]
    exact ⟨63666406310520881776, by unfold P; norm_num⟩
  simpa [h] using two_pow5_char (k := 13) (by norm_num) ha n
/-- **10-digit answer**: with `x ≡ 1220703125 (mod 9999999999)` and
`0 < x < 9999999999` (so `x = a₁ = 1220703125`) and
`n ≡ 1628355764 (mod 2441406250)`, the fraction `P n / x` is an integer. -/
theorem answer_10 (x n : ℤ) (hx : 0 < x) (hxb : x < 9999999999)
    (hx1 : x ≡ 1220703125 [ZMOD 9999999999])
    (hn : n ≡ 1628355764 [ZMOD 2441406250]) :
    ∃ q : ℤ, P n = x * q := by
  obtain ⟨c, hc⟩ := Int.ModEq.dvd hx1
  have hxeq : x = 1220703125 := by omega
  subst hxeq
  obtain ⟨q, hq⟩ := (char_10 n).mpr hn
  exact ⟨2 * q, by rw [hq]; ring⟩
