/-!
## Digit counts and `a₁ ≠ b₂`
Each of the four constants `a₁, b₁, a₂, b₂` used above has exactly the advertised number
of digits, i.e. lies in `[10^(d-1), 10^d)`, and `a₁` differs from `b₂`.
-/
theorem digits_10 :
    10 ^ 9 ≤ (1220703125 : ℤ) ∧ (1220703125 : ℤ) < 10 ^ 10 ∧
    10 ^ 9 ≤ (9999999999 : ℤ) ∧ (9999999999 : ℤ) < 10 ^ 10 ∧
    10 ^ 9 ≤ (1628355764 : ℤ) ∧ (1628355764 : ℤ) < 10 ^ 10 ∧
    10 ^ 9 ≤ (2441406250 : ℤ) ∧ (2441406250 : ℤ) < 10 ^ 10 ∧
    (1220703125 : ℤ) ≠ (2441406250 : ℤ) := by
  norm_num
theorem digits_20 :
    10 ^ 19 ≤ (37252902984619140625 : ℤ) ∧ (37252902984619140625 : ℤ) < 10 ^ 20 ∧
    10 ^ 19 ≤ (99999999999999999999 : ℤ) ∧ (99999999999999999999 : ℤ) < 10 ^ 20 ∧
    10 ^ 19 ≤ (52771027728679137014 : ℤ) ∧ (52771027728679137014 : ℤ) < 10 ^ 20 ∧
    10 ^ 19 ≤ (74505805969238281250 : ℤ) ∧ (74505805969238281250 : ℤ) < 10 ^ 20 ∧
    (37252902984619140625 : ℤ) ≠ (74505805969238281250 : ℤ) := by
  norm_num
theorem digits_30 :
    10 ^ 29 ≤ (227373675443232059478759765625 : ℤ) ∧ (227373675443232059478759765625 : ℤ) < 10 ^ 30 ∧
    10 ^ 29 ≤ (999999999999999999999999999999 : ℤ) ∧ (999999999999999999999999999999 : ℤ) < 10 ^ 30 ∧
    10 ^ 29 ≤ (416900266461691315814616637014 : ℤ) ∧ (416900266461691315814616637014 : ℤ) < 10 ^ 30 ∧
    10 ^ 29 ≤ (454747350886464118957519531250 : ℤ) ∧ (454747350886464118957519531250 : ℤ) < 10 ^ 30 ∧
    (227373675443232059478759765625 : ℤ) ≠ (454747350886464118957519531250 : ℤ) := by
